# =========================================================
# OSSmith Backend — Example Environment Variables
# =========================================================
# Copy this file to .env and adjust as needed.
# Never commit your actual .env file.
# =========================================================

# --- Project metadata -------------------------------------
PROJECT_NAME=OSSmith
VERSION=0.2.0-alpha

# --- Runtime environment ------------------------------------
# development | staging | production | test
ENVIRONMENT=development
DEBUG=true

# --- Server ---------------------------------------------------
HOST=0.0.0.0
PORT=8000

# --- Logging ----------------------------------------------------
# debug | info | warning | error | critical
LOG_LEVEL=info

# --- Database -------------------------------------------------------
# Defaults to a local SQLite file — no external database required
# to run the project. Point this at PostgreSQL or another SQLAlchemy-
# supported backend for staging/production.
DATABASE_URL=sqlite:///./ossmith.db

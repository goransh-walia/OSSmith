# =========================================================
# OSSmith — Example Environment Variables
# =========================================================
# Copy this file to .env and fill in real values.
# Never commit your actual .env file.
#
# Sprint 1 does not yet consume these variables in application
# code — they are defined here so the configuration surface is
# established ahead of the backend/frontend implementation.
# =========================================================

# ---------------------------
# General
# ---------------------------
ENVIRONMENT=development        # development | staging | production
LOG_LEVEL=info                 # debug | info | warning | error

# ---------------------------
# Backend (FastAPI)
# ---------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true

# ---------------------------
# Frontend (Next.js)
# ---------------------------
NEXT_PUBLIC_APP_NAME=OSSmith
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---------------------------
# Database (placeholder — not wired up in Sprint 1)
# ---------------------------
DATABASE_URL=postgresql://ossmith:ossmith@localhost:5432/ossmith

# ---------------------------
# Future integrations (not used yet)
# ---------------------------
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# ANTHROPIC_API_KEY=
